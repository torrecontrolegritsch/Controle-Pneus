# Copie este arquivo para .env e preencha com os valores reais
# NUNCA commite o .env — apenas este .env.example

# Supabase
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_KEY=eyJ...service_role_key...

# Banco Postgres direto (opcional, para migrações)
SUPABASE_DB_URL=postgresql://postgres.SEU_PROJETO:SENHA@aws-0-us-east-1.pooler.supabase.com:443/postgres

# SQL Server (consulta de veículos)
SQLSERVER_HOST=
SQLSERVER_PORT=1433
SQLSERVER_USER=
SQLSERVER_PASSWORD=
SQLSERVER_DB=

# JWT — gere com: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=gere_uma_chave_de_64_caracteres_aqui

# App
PORT=8015
CORS_ORIGINS=http://localhost:5173,http://localhost:8015,https://SEU_DOMINIO.vercel.app
